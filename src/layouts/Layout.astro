---
import Analytics from '@vercel/analytics/astro'
import type { Lang } from '@/i18n'
import { getDict } from '@/i18n'
import '@/styles/global.css'

interface Props {
  title: string
  description: string
  lang: Lang
}

const { title, description, lang } = Astro.props
const dict = getDict(lang)

const switcherHref = lang === 'es' ? '/en/' : '/'
const switcherLabel = lang === 'es' ? dict.layout.switcherEn : dict.layout.switcherEs

const hrefEs = '/'
const hrefEn = '/en/'
const hrefDefault = '/'
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset='UTF-8' />
    <meta name='description' content={description} />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <link rel='icon' href='/letra-e.png' />
    <meta name='generator' content={Astro.generator} />

    <link rel='alternate' hreflang='es' href={hrefEs} />
    <link rel='alternate' hreflang='en' href={hrefEn} />
    <link rel='alternate' hreflang='x-default' href={hrefDefault} />

    <!-- Google Fonts -->
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=JetBrains+Mono:wght@400;500&display=swap'
      rel='stylesheet'
    />

    <title>{title}</title>

    <!-- Canonical URL -->
    <link rel='canonical' href={`https://ezequielemenor.es${Astro.url.pathname}`} />

    <!-- Open Graph / Facebook -->
    <meta property='og:type' content='website' />
    <meta property='og:url' content={`https://ezequielemenor.es${Astro.url.pathname}`} />
    <meta property='og:title' content={title} />
    <meta property='og:description' content={description} />
    <meta property='og:image' content='https://ezequielemenor.es/Mi-porfolio2.png' />

    <!-- Twitter -->
    <meta property='twitter:card' content='summary_large_image' />
    <meta
      property='twitter:url'
      content={`https://ezequielemenor.es${Astro.url.pathname}`}
    />
    <meta property='twitter:title' content={title} />
    <meta property='twitter:description' content={description} />
    <meta property='twitter:image' content='https://ezequielemenor.es/Mi-porfolio2.png' />

    <!-- JSON-LD Structured Data -->
    <script
      type='application/ld+json'
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Person',
            '@id': 'https://ezequielemenor.es/#person',
            name: 'Ezequiel Menor',
            url: 'https://ezequielemenor.es',
            jobTitle: lang === 'es' ? 'Desarrollador Full-Stack' : 'Full-Stack Developer',
            description:
              lang === 'es'
                ? 'Desarrollador Full-Stack especializado en Flutter, Spring Boot, TypeScript y Agentes de IA.'
                : 'Full-Stack Developer specialized in Flutter, Spring Boot, TypeScript and AI Agents.',
            sameAs: [
              'https://github.com/EzequielMenor',
              'https://www.linkedin.com/in/ezequiel-menor-4a690027a/',
            ],
            knowsAbout: [
              'Flutter',
              'Dart',
              'Java',
              'Spring Boot',
              'JavaScript',
              'TypeScript',
              'Astro',
              'SQL',
              'MySQL',
              'AI Agents',
              'LLMs',
            ],
            worksFor: [
              {
                '@type': 'Organization',
                name: 'Clínicas Dorsia',
                url: 'https://www.clinicasdorsia.com/',
              },
            ],
            address: {
              '@type': 'PostalAddress',
              addressLocality: 'Gandía',
              addressRegion: 'Valencia',
              addressCountry: 'ES',
            },
          },
          {
            '@type': 'WebSite',
            '@id': 'https://ezequielemenor.es/#website',
            name: 'Ezequiel Menor — Portfolio',
            url: 'https://ezequielemenor.es',
            author: { '@id': 'https://ezequielemenor.es/#person' },
          },
        ],
      })}
    />

    <!-- Theme init — blocking to prevent FOUC -->
    <script is:inline>
      ;(function () {
        const theme =
          localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
        if (theme === 'dark') {
          document.documentElement.classList.add('dark')
        }
      })()
    </script>
  </head>
  <body
    class='bg-[var(--color-bg)] text-[var(--color-text)] transition-colors duration-300 relative overflow-x-hidden min-h-screen'
  >
    <!-- Minimalist Editorial Navigation Header -->
    <header
      class='sticky top-0 z-40 w-full backdrop-blur-md bg-[var(--color-bg)]/90 border-b border-[var(--color-border)] print:hidden transition-colors duration-300'
    >
      <div class='max-w-3xl mx-auto px-6 h-14 flex items-center justify-between'>
        <a href='#hero' class='flex items-center gap-2 group'>
          <span
            class='font-serif text-lg tracking-tight text-[var(--color-text)] group-hover:text-[var(--color-text-muted)] transition-colors'
          >
            Ezequiel Menor
          </span>
        </a>

        <nav
          class='hidden sm:flex items-center gap-5 text-xs font-mono text-[var(--color-text-muted)]'
        >
          <a href='#projects' class='hover:text-[var(--color-text)] transition-colors'
            >{dict.sections.projects}</a
          >
          <a href='#experience' class='hover:text-[var(--color-text)] transition-colors'
            >{dict.sections.experience}</a
          >
          <a href='#skills' class='hover:text-[var(--color-text)] transition-colors'
            >{dict.sections.skills}</a
          >
          <a href='#education' class='hover:text-[var(--color-text)] transition-colors'
            >{dict.sections.education}</a
          >
        </nav>

        <div class='flex items-center gap-2.5'>
          <!-- Language Switcher -->
          <a
            href={switcherHref}
            hreflang={lang === 'es' ? 'en' : 'es'}
            aria-label={switcherLabel}
            class='px-2.5 py-1 rounded text-xs font-mono border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:border-[var(--color-border-hover)] transition-colors'
          >
            {switcherLabel}
          </a>

          <!-- Theme Toggle -->
          <button
            id='theme-toggle'
            aria-label={dict.layout.themeToggle}
            title={dict.layout.themeToggleTitle}
            class='p-1.5 rounded border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:border-[var(--color-border-hover)] transition-colors cursor-pointer'
          >
            <svg
              id='theme-icon-sun'
              class='w-3.5 h-3.5 hidden dark:block'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              viewBox='0 0 24 24'
            >
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                d='M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z'
              ></path>
            </svg>
            <svg
              id='theme-icon-moon'
              class='w-3.5 h-3.5 block dark:hidden'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              viewBox='0 0 24 24'
            >
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                d='M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z'
              ></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <div class='relative z-10'>
      <slot />
    </div>

    <Analytics />

    <script is:inline>
      ;(function () {
        const toggle = document.getElementById('theme-toggle')
        if (!toggle) return

        toggle.addEventListener('click', () => {
          const html = document.documentElement
          const isDark = html.classList.toggle('dark')
          localStorage.setItem('theme', isDark ? 'dark' : 'light')
        })
      })()

      ;(function () {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible')
              }
            })
          },
          { threshold: 0.08 },
        )

        document.querySelectorAll('[data-animate="true"]').forEach((el) => {
          el.classList.add('animate-on-scroll')
          observer.observe(el)
        })
      })()
    </script>
  </body>
</html>
