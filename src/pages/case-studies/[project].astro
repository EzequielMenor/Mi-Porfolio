---
import Layout from '@/layouts/Layout.astro'
import CaseStudy from '@/components/CaseStudy.astro'
import { caseStudies, caseStudySlugs } from '@/data/case-studies'
import { getDict } from '@/i18n'

export function getStaticPaths() {
  return caseStudySlugs.map((slug) => ({ params: { project: slug } }))
}

const dict = getDict('es')
const study = caseStudies.es[Astro.params.project as (typeof caseStudySlugs)[number]]
---

<Layout title={study.meta.title} description={study.meta.description} lang='es'>
  <CaseStudy study={study} dict={dict} base='' />
</Layout>
