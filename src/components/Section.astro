---
const { title } = Astro.props
---

<section class='mb-12 mx-auto w-full'>
  {
    title && (
      <h2 class='text-xl md:text-2xl font-heading font-bold text-[var(--color-text)] mb-8 pb-2 border-b-2 border-[var(--color-accent-mint)] w-fit'>
        {title}
      </h2>
    )
  }
  <slot />
</section>
