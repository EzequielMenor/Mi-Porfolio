---
interface Props {
  title?: string
  id?: string
  subtitle?: string
}

const { title, id, subtitle } = Astro.props
---

<section id={id} class='mb-16 mx-auto w-full scroll-mt-20'>
  {
    title && (
      <div class='flex items-baseline justify-between border-b border-[var(--color-border)] pb-2.5 mb-6 text-[var(--color-text)]'>
        <h2 class='font-serif text-2xl font-normal tracking-tight'>{title}</h2>
        {subtitle && (
          <span class='text-xs font-mono text-[var(--color-text-muted)]'>{subtitle}</span>
        )}
      </div>
    )
  }
  <slot />
</section>
