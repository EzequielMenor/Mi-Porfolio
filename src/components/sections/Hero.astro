---
import type { Dict } from '@/i18n'

interface Props {
  basics: {
    name: string
    label: string
    image?: string
    email: string
    phone: string
    summary: string
    techTags: string[]
    location: { city: string; region: string }
    profiles: { network: string; username: string; url: string }[]
  }
  dict: Dict
}

const { basics, dict } = Astro.props
const { name, location, profiles, summary } = basics
const { city, region } = location
---

<section id='hero' class='pt-12 pb-16 space-y-6'>
  <div
    data-hero-stagger
    class='flex items-center justify-between text-xs font-mono text-[var(--color-text-muted)] uppercase tracking-widest'
  >
    <span>{name} &mdash; Portfolio</span>
    <span>{city}, {region}</span>
  </div>

  <h1
    data-typing-text={summary}
    data-hero-stagger
    aria-label={summary}
    class='font-serif text-4xl sm:text-5xl md:text-6xl text-[var(--color-text)] font-normal tracking-tight leading-[1.12]'
  >
    <noscript>{summary}</noscript>
  </h1>

  <div
    data-hero-stagger
    class='flex flex-col sm:flex-row sm:items-baseline justify-between gap-4 pt-4 border-t border-[var(--color-border)] text-[var(--color-text-muted)] text-sm'
  >
    <p class='max-w-md font-light leading-relaxed'>
      {dict.hero.bio}
    </p>

    <div class='flex flex-wrap items-center gap-4 text-xs font-mono'>
      {
        profiles.map(({ network, url }) => (
          <a
            href={url}
            target='_blank'
            rel='noopener noreferrer'
            class='link-underline text-[var(--color-text)] hover:text-[var(--color-text)] transition-colors'
          >
            {network}
            <span class='arrow-hover'>&nearr;</span>
          </a>
        ))
      }
      <a
        href='https://www.stackd.codes'
        target='_blank'
        rel='noopener noreferrer'
        class='link-underline text-[var(--color-text)] hover:text-[var(--color-text)] transition-colors'
      >
        Stackd
        <span class='arrow-hover'>&nearr;</span>
      </a>
    </div>
  </div>
</section>
