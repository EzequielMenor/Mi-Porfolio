---
import Section from "../Section.astro";

import { projects } from "@cv";

const featured = projects.filter((p) => p.featured);
const other = projects.filter((p) => !p.featured);
---

<Section title="Proyectos">
  {
    featured.map(({ name, description, highlights, repos }) => (
      <article class="featured">
        <header>
          <h3>
            {name}
            <span class="badge">Destacado</span>
          </h3>
          <p>{description}</p>
        </header>
        <footer>
          {highlights.map((h) => <span>{h}</span>)}
        </footer>
        <div class="repos">
          {repos?.mobile && <a href={repos.mobile}>App móvil →</a>}
          {repos?.desktop && <a href={repos.desktop}>App escritorio →</a>}
          {repos?.backend && <a href={repos.backend}>Backend →</a>}
        </div>
      </article>
    ))
  }

  {
    other.length > 0 && (
      <ul>
        {other.map(({ url, description, highlights, name }) => (
          <li>
            <article>
              <header>
                <h3>
                  <a href={url} title={`Ver el proyecto ${name}`}>
                    {name}
                  </a>
                </h3>
                <p>{description}</p>
              </header>
              <footer>
                {highlights.map((h) => <span>{h}</span>)}
              </footer>
            </article>
          </li>
        ))}
      </ul>
    )
  }
</Section>

<style>
  article.featured {
    border-radius: 8px;
    border: 1px solid #e0e0e0;
    padding: 24px;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  article.featured h3 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 8px;
  }

  article.featured h3 a {
    color: #111;
  }

  article.featured h3 a:hover {
    text-decoration: underline;
  }

  article.featured .badge {
    font-size: 0.65rem;
    font-weight: 600;
    background: #111;
    color: #fff;
    padding: 2px 8px;
    border-radius: 4px;
    margin-left: 8px;
    vertical-align: middle;
  }

  article.featured p {
    font-size: 0.85rem;
    line-height: 1.5;
  }

  article.featured footer {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  article.featured footer span {
    border-radius: 6px;
    background: #000;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
  }

  .repos {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .repos a {
    font-size: 0.8rem;
    color: #555;
    border: 1px solid #ddd;
    padding: 6px 12px;
    border-radius: 6px;
    transition: all 0.2s ease;
  }

  .repos a:hover {
    background: #f5f5f5;
    color: #111;
    border-color: #bbb;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  ul article {
    border-radius: 8px;
    border: 1px solid #f2f2f2;
    gap: 16px;
    display: flex;
    flex-direction: column;
    padding: 16px;
    height: 100%;
  }

  ul article header {
    flex: 1;
  }

  ul article h3 {
    font-size: 1.17em;
    font-weight: bold;
  }

  ul article h3 a {
    color: #111;
  }

  ul article h3 a:hover {
    text-decoration: underline;
  }

  ul article p {
    font-size: 0.75rem;
    line-height: 1.2rem;
    margin-bottom: 4px;
  }

  ul article footer {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  ul article footer span {
    border-radius: 6px;
    background: #000;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
  }
</style>
