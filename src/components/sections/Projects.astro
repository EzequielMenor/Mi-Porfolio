---
import Section from '@/components/Section.astro'
import type { Dict } from '@/i18n'

interface Props {
  projects: Array<{
    name: string
    description: string
    highlights: string[]
    featured?: boolean
    url?: string
    repos?: { mobile?: string; desktop?: string; backend?: string }
  }>
  dict: Dict
}

const { projects, dict } = Astro.props
const featured = projects.filter((p) => p.featured)
const other = projects.filter((p) => !p.featured)
---

<Section title={dict.sections.projects} subtitle='2024 — 2026'>
  <div class='divide-y divide-[var(--color-border)]'>
    {
      featured.map(({ name, description, highlights, url, repos }, idx) => (
        <article
          data-stagger-item
          class='featured-project py-8 group flex flex-col md:flex-row md:items-start justify-between gap-6'
        >
          <div class='md:w-1/3'>
            <span class='project-index text-xs font-mono text-[var(--color-text-muted)] block mb-1'>
              0{idx + 1}
            </span>
            <h3 class='font-serif text-2xl text-[var(--color-text)] group-hover:text-[var(--color-text-muted)] transition-colors flex items-center gap-1.5'>
              {url ? (
                <a
                  href={url}
                  target='_blank'
                  rel='noopener noreferrer'
                  class='link-underline inline-flex items-center gap-1'
                >
                  {name}
                  <span class='arrow-hover text-base font-sans text-[var(--color-text-muted)]'>
                    &nearr;
                  </span>
                </a>
              ) : (
                name
              )}
            </h3>
            <span class='text-xs font-mono text-[var(--color-text-muted)] mt-1 flex items-center gap-1.5'>
              {name === 'AIES' && (
                <span class='w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse inline-block' />
              )}
              <span>
                {name === 'AIES'
                  ? dict.projects.aiesTag
                  : name === 'Stackd'
                    ? dict.projects.stackdTag
                    : dict.projects.tfgTag}
              </span>
            </span>
          </div>

          <div class='md:w-2/3 space-y-4'>
            <p class='text-sm text-[var(--color-text)] leading-relaxed font-light opacity-90'>
              {description}
            </p>

            <div class='flex flex-wrap items-center justify-between gap-4 text-xs font-mono pt-2'>
              <div class='flex flex-wrap gap-2'>
                {highlights.map((h: string) => (
                  <span class='text-[var(--color-text-muted)] bg-[var(--color-surface-2)] px-2 py-0.5 rounded border border-[var(--color-border)]'>
                    {h}
                  </span>
                ))}
              </div>

              <div class='flex items-center gap-3'>
                {url && (
                  <a
                    href={url}
                    target='_blank'
                    rel='noopener noreferrer'
                    class='font-medium text-[var(--color-text)] underline underline-offset-4 decoration-[var(--color-border)] hover:decoration-[var(--color-text)] transition-colors'
                  >
                    Sitio web &nearr;
                  </a>
                )}
                {repos?.mobile && (
                  <a
                    href={repos.mobile}
                    target='_blank'
                    rel='noopener noreferrer'
                    class='text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors'
                  >
                    {dict.projects.repoMobile}
                  </a>
                )}
                {repos?.desktop && (
                  <a
                    href={repos.desktop}
                    target='_blank'
                    rel='noopener noreferrer'
                    class='text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors'
                  >
                    {dict.projects.repoDesktop}
                  </a>
                )}
                {repos?.backend && (
                  <a
                    href={repos.backend}
                    target='_blank'
                    rel='noopener noreferrer'
                    class='text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors'
                  >
                    {dict.projects.repoBackend}
                  </a>
                )}
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  {
    other.length > 0 && (
      <div class='pt-6 border-t border-[var(--color-border)] mt-4'>
        <h4 class='text-xs font-mono uppercase tracking-widest text-[var(--color-text-muted)] mb-4'>
          Otros Proyectos
        </h4>
        <div class='grid grid-cols-1 sm:grid-cols-2 gap-4'>
          {other.map(({ name, description, highlights, url }) => (
            <article
              data-stagger-item
              class='card-hover p-4 rounded-lg bg-[var(--color-surface)] border border-[var(--color-border)] space-y-2'
            >
              <h5 class='font-serif text-lg text-[var(--color-text)]'>
                {url ? (
                  <a
                    href={url}
                    target='_blank'
                    rel='noopener noreferrer'
                    class='link-underline inline-flex items-center gap-1'
                  >
                    {name}{' '}
                    <span class='arrow-hover text-xs font-mono text-[var(--color-text-muted)]'>
                      &nearr;
                    </span>
                  </a>
                ) : (
                  name
                )}
              </h5>
              <p class='text-xs text-[var(--color-text-muted)] font-light leading-relaxed'>
                {description}
              </p>
              <div class='flex flex-wrap gap-1.5 pt-1'>
                {highlights.map((h: string) => (
                  <span class='text-[11px] font-mono text-[var(--color-text-muted)] bg-[var(--color-surface-2)] px-1.5 py-0.5 rounded'>
                    {h}
                  </span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    )
  }
</Section>
