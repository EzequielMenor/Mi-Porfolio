---
import Section from '../Section.astro'
import type { Dict } from '@/i18n'

interface Props {
  summary: string
  dict: Dict
}

const { summary, dict } = Astro.props
---

<Section title={dict.sections.about}>
  <div
    class='p-6 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-sm'
  >
    <p class='text-sm sm:text-base leading-relaxed text-[var(--color-text-muted)]'>
      {summary}
    </p>
  </div>
</Section>
