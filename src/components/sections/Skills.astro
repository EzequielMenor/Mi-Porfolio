---
import Section from '@/components/Section.astro'
import type { Dict } from '@/i18n'

interface Props {
  skills: Array<{ name: string; level: string; keywords?: string[] }>
  dict: Dict
}

const { skills, dict } = Astro.props
---

<Section title={dict.sections.skills}>
  <div class='grid grid-cols-1 sm:grid-cols-3 gap-6 font-mono text-xs'>
    <div
      data-stagger-item
      class='skill-card space-y-2.5 p-4 rounded-lg bg-[var(--color-surface)] border border-[var(--color-border)]'
    >
      <span
        class='text-[10px] uppercase tracking-wider text-[var(--color-text-muted)] font-semibold block'
      >
        01. Frontend & Mobile
      </span>
      <ul class='space-y-1 text-[var(--color-text)]'>
        <li>TypeScript / JavaScript</li>
        <li>React / React Native</li>
        <li>Flutter & Dart</li>
        <li>Astro & Tailwind CSS</li>
      </ul>
    </div>

    <div
      data-stagger-item
      class='skill-card space-y-2.5 p-4 rounded-lg bg-[var(--color-surface)] border border-[var(--color-border)]'
    >
      <span
        class='text-[10px] uppercase tracking-wider text-[var(--color-text-muted)] font-semibold block'
      >
        02. Backend & APIs
      </span>
      <ul class='space-y-1 text-[var(--color-text)]'>
        <li>Java & Spring Boot</li>
        <li>APIs REST</li>
        <li>PostgreSQL / SQL</li>
        <li>Git</li>
      </ul>
    </div>

    <div
      data-stagger-item
      class='skill-card space-y-2.5 p-4 rounded-lg bg-[var(--color-surface)] border border-[var(--color-border)]'
    >
      <span
        class='text-[10px] uppercase tracking-wider text-[var(--color-text-muted)] font-semibold block'
      >
        03. IA & Arquitectura
      </span>
      <ul class='space-y-1 text-[var(--color-text)]'>
        <li>IA aplicada al desarrollo</li>
        <li>LLMs & prompting</li>
        <li>Agentes IA</li>
        <li>Clean Architecture</li>
      </ul>
    </div>
  </div>
</Section>
