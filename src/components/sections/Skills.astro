---
import Section from '@/components/Section.astro'
import type { Dict } from '@/i18n'

interface Props {
  skills: Array<{ name: string; level: string; keywords?: string[] }>
  dict: Dict
}

const { skills, dict } = Astro.props
---

<Section title={dict.sections.skills}>
  <div class='grid grid-cols-1 sm:grid-cols-3 gap-6 font-mono text-xs'>
    <div
      class='space-y-2.5 p-4 rounded-lg bg-[var(--color-surface)] border border-[var(--color-border)]'
    >
      <span
        class='text-[10px] uppercase tracking-wider text-[var(--color-text-muted)] font-semibold block'
      >
        01. Frontend & Mobile
      </span>
      <ul class='space-y-1 text-[var(--color-text)]'>
        <li>Flutter & Dart</li>
        <li>Astro & Next.js</li>
        <li>TypeScript / JavaScript</li>
        <li>Tailwind CSS</li>
      </ul>
    </div>

    <div
      class='space-y-2.5 p-4 rounded-lg bg-[var(--color-surface)] border border-[var(--color-border)]'
    >
      <span
        class='text-[10px] uppercase tracking-wider text-[var(--color-text-muted)] font-semibold block'
      >
        02. Backend & APIs
      </span>
      <ul class='space-y-1 text-[var(--color-text)]'>
        <li>Java & Spring Boot</li>
        <li>MySQL & PostgreSQL</li>
        <li>REST Architecture</li>
        <li>MongoDB</li>
      </ul>
    </div>

    <div
      class='space-y-2.5 p-4 rounded-lg bg-[var(--color-surface)] border border-[var(--color-border)]'
    >
      <span
        class='text-[10px] uppercase tracking-wider text-[var(--color-text-muted)] font-semibold block'
      >
        03. IA & Arquitectura
      </span>
      <ul class='space-y-1 text-[var(--color-text)]'>
        <li>Harness de Agentes IA</li>
        <li>LLMs & System Prompting</li>
        <li>Clean Architecture</li>
        <li>Git & CI/CD</li>
      </ul>
    </div>
  </div>
</Section>
