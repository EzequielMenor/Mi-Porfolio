---
import Section from '../Section.astro'
import type { Dict } from '@/i18n'

interface Props {
  education: Array<{
    institution: string
    url?: string
    area: string
    studyType: string
    startDate: string
    endDate: string
    courses?: string[]
  }>
  dict: Dict
}

const { education, dict } = Astro.props

function formatYear(date: string) {
  return date ? date.slice(0, 4) : ''
}
---

<Section title={dict.sections.education}>
  <div class='divide-y divide-[var(--color-border)]'>
    {
      education.map(({ institution, area, studyType, startDate, endDate }) => {
        const startYear = formatYear(startDate)
        const endYear = formatYear(endDate)

        return (
          <div
            data-stagger-item
            class='py-4 flex flex-col sm:flex-row sm:items-baseline justify-between gap-1'
          >
            <div>
              <h3 class='text-sm font-medium text-[var(--color-text)]'>{area}</h3>
              <p class='text-xs font-mono text-[var(--color-text-muted)]'>
                {institution} &bull; {studyType}
              </p>
            </div>
            <span class='text-xs font-mono text-[var(--color-text-muted)]'>
              {startYear} &mdash; {endYear}
            </span>
          </div>
        )
      })
    }
  </div>
</Section>
