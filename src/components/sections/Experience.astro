---
import Section from '../Section.astro'
import type { Dict } from '@/i18n'

interface Props {
  work: Array<{
    name: string
    position: string
    url?: string
    startDate: string
    endDate: string | null
    summary: string
    highlights?: string[]
    type?: string
  }>
  dict: Dict
}

const { work, dict } = Astro.props
const main = work.filter((w) => w.type !== 'secondary')
const secondary = work.filter((w) => w.type === 'secondary')

function formatYear(date: string) {
  return date ? date.slice(0, 4) : ''
}
---

<Section title={dict.sections.experience}>
  <div class='divide-y divide-[var(--color-border)]'>
    {
      main.map(({ name, startDate, endDate, position, summary, highlights, url }) => {
        const startYear = formatYear(startDate)
        const endLabel = endDate ? formatYear(endDate) : dict.experience.present

        return (
          <article
            data-stagger-item
            class='py-6 flex flex-col sm:flex-row sm:items-start justify-between gap-4'
          >
            <div class='sm:w-1/3'>
              <h3 class='font-medium text-sm text-[var(--color-text)]'>{position}</h3>
              <p class='text-xs font-mono text-[var(--color-text-muted)] mt-0.5'>
                {url ? (
                  <a
                    href={url}
                    target='_blank'
                    rel='noopener noreferrer'
                    class='link-underline hover:text-[var(--color-text)] underline decoration-[var(--color-border)] underline-offset-2'
                  >
                    {name}
                    <span class='arrow-hover'>&nearr;</span>
                  </a>
                ) : (
                  name
                )}
              </p>
              <time class='text-xs font-mono text-[var(--color-text-muted)] opacity-80 block mt-1'>
                {startYear} &mdash; {endLabel}
              </time>
            </div>

            <div class='sm:w-2/3 space-y-3'>
              <p class='text-sm text-[var(--color-text-muted)] font-light leading-relaxed'>
                {summary}
              </p>
              {highlights && highlights.length > 0 && (
                <div class='flex flex-wrap gap-1.5'>
                  {highlights.map((h) => (
                    <span class='text-xs font-mono text-[var(--color-text-muted)] bg-[var(--color-surface-2)] px-2 py-0.5 rounded'>
                      {h}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </article>
        )
      })
    }
  </div>

  {
    secondary.length > 0 && (
      <div class='mt-6 pt-4 border-t border-[var(--color-border)]'>
        <h4 class='text-xs font-mono uppercase tracking-wider text-[var(--color-text-muted)] mb-3'>
          {dict.sections.otherWork}
        </h4>
        <ul class='space-y-2'>
          {secondary.map(({ name, position, startDate, endDate }) => {
            const startYear = formatYear(startDate)
            const endLabel = endDate ? formatYear(endDate) : dict.experience.present
            return (
              <li
                data-stagger-item
                class='text-xs font-mono text-[var(--color-text-muted)] flex justify-between gap-4 p-2 rounded bg-[var(--color-surface-2)]'
              >
                <span>
                  <strong class='text-[var(--color-text)] font-medium'>{name}</strong>{' '}
                  &bull; {position}
                </span>
                <span>
                  {startYear} &mdash; {endLabel}
                </span>
              </li>
            )
          })}
        </ul>
      </div>
    )
  }
</Section>
