---
import Section from '../Section.astro'
import type { Dict } from '@/i18n'

interface Props {
  work: Array<{
    name: string
    position: string
    startDate: string
    endDate: string | null
    summary: string
    highlights?: string[]
    type?: string
  }>
  dict: Dict
}

const { work, dict } = Astro.props
const main = work.filter((w) => w.type !== 'secondary')
const secondary = work.filter((w) => w.type === 'secondary')

function endYear(endDate: string | null, presentLabel: string) {
  return endDate != null ? new Date(endDate).getFullYear().toString() : presentLabel
}
---

<Section title={dict.sections.experience}>
  {
    main.length > 0 && (
      <div class='relative pl-8 border-l-2 border-[var(--color-border)]'>
        {main.map(({ name, startDate, endDate, position, summary, highlights }) => {
          const startYear = new Date(startDate).getFullYear()
          const endLabel = endYear(endDate, dict.experience.present)
          const years = `${startYear} - ${endLabel}`

          return (
            <div class='relative mb-10 last:mb-0'>
              <span class='absolute w-3 h-3 bg-[var(--color-accent-mint)] rounded-full -left-[calc(2rem+6px)] top-1.5 ring-[3px] ring-[var(--color-bg)]' />

              <article>
                <header class='flex justify-between items-start mb-2'>
                  <div>
                    <h3 class='font-bold text-[var(--color-text)]'>{name}</h3>
                    <h4 class='text-[var(--color-text-muted)] font-normal text-sm mt-0.5'>
                      {position}
                    </h4>
                  </div>

                  <time class='text-[var(--color-text-muted)] text-xs min-w-[100px] text-right flex-shrink-0'>
                    {years}
                  </time>
                </header>

                <p class='text-[var(--color-text-muted)] text-sm leading-relaxed mb-3'>
                  {summary}
                </p>

                {highlights && highlights.length > 0 && (
                  <div class='flex flex-wrap gap-1.5'>
                    {highlights.map((tech: string) => (
                      <span class='text-xs px-2 py-0.5 rounded-md bg-[var(--color-surface-2)] text-[var(--color-text-muted)] font-code'>
                        {tech}
                      </span>
                    ))}
                  </div>
                )}
              </article>
            </div>
          )
        })}
      </div>
    )
  }

  {
    secondary.length > 0 && (
      <div class='mt-10'>
        <h3 class='text-sm font-code uppercase tracking-wider text-[var(--color-text-muted)] mb-4'>
          {dict.sections.otherWork}
        </h3>
        <ul class='flex flex-col gap-2'>
          {secondary.map(({ name, position, startDate, endDate }) => {
            const startYear = new Date(startDate).getFullYear()
            const endLabel = endYear(endDate, dict.experience.present)
            return (
              <li class='text-sm text-[var(--color-text-muted)] flex justify-between gap-4'>
                <span>
                  <strong class='text-[var(--color-text)] font-medium'>{name}</strong> ·{' '}
                  {position}
                </span>
                <time class='font-code text-xs whitespace-nowrap'>
                  {startYear} - {endLabel}
                </time>
              </li>
            )
          })}
        </ul>
      </div>
    )
  }
</Section>
