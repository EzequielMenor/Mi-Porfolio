---
import Section from "../Section.astro";

import { work } from '@cv'

---

<Section title="Experiencia laboral">
    <div class='relative pl-8 border-l-2 border-[var(--color-border)]'>
        {work.map(( {name, startDate, endDate, position, summary, highlights}) => {
            const startYear = new Date(startDate).getFullYear()
            const endYear = endDate != null ? new Date(endDate).getFullYear() : "Actual"
            const years =`${startYear} - ${endYear}`

            return (
                <div class='relative mb-10 last:mb-0'>
                    <!-- Timeline dot -->
                    <span class='absolute w-3 h-3 bg-[var(--color-accent-mint)] rounded-full -left-[calc(2rem+6px)] top-1.5 ring-[3px] ring-[var(--color-bg)]'></span>

                    <article>
                        <header class='flex justify-between items-start mb-2'>
                            <div>
                                <h3 class='font-bold text-[var(--color-text)]'>{name}</h3>
                                <h4 class='text-[var(--color-text-muted)] font-normal text-sm mt-0.5'>{position}</h4>
                            </div>

                            <time class='text-[var(--color-text-muted)] text-xs min-w-[100px] text-right flex-shrink-0'>{years}</time>
                        </header>

                        <p class='text-[var(--color-text-muted)] text-sm leading-relaxed mb-3'>{summary}</p>

                        {highlights && highlights.length > 0 && (
                            <div class='flex flex-wrap gap-1.5'>
                                {highlights.map((tech: string) => (
                                    <span class='text-xs px-2 py-0.5 rounded-md bg-[var(--color-surface-2)] text-[var(--color-text-muted)] font-code'>
                                        {tech}
                                    </span>
                                ))}
                            </div>
                        )}
                    </article>
                </div>
            )
        })}
    </div>
</Section>
